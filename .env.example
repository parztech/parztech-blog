# Database: leave empty locally to use ./local.db (SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed into /admin
ADMIN_GITHUB_LOGINS=

# Local only: one-click admin login during `npm run dev` (ignored in production)
AUTH_DEV_LOGIN=true

# SEO
# Public address override; on Vercel it defaults to https://www.parztech.am
NEXT_PUBLIC_SITE_URL=
# Google Search Console → HTML tag verification → the content="..." value
GOOGLE_SITE_VERIFICATION=

# Telegram: channel username (e.g. parztech) shows "Join" links on the site;
# with a bot token (from @BotFather, bot added as channel admin) new posts are
# posted to the channel automatically on first publish (production only)
TELEGRAM_CHANNEL=
TELEGRAM_BOT_TOKEN=
